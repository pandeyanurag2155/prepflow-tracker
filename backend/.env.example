# Copy to .env and adjust. Real environment variables win over this file.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# docker compose exposes Postgres on 5433 so it won't clash with a local install
DATABASE_URL=postgres://prepflow:prepflow@localhost:5433/prepflow
DB_POOL_MAX=10

# Revisit dates (done + 3 / + 7 days) are calendar days in this timezone
APP_TIMEZONE=Asia/Kolkata

# Serve ../frontend from the API process (single origin, no CORS needed).
# Set to false when the frontend is hosted separately, and list its origin(s) in CORS_ORIGIN.
SERVE_FRONTEND=true
CORS_ORIGIN=

# How long a login lasts on a device. The account is created on the app's sign-up page.
# Forgot the password? npm run auth:reset-password
SESSION_DAYS=30
